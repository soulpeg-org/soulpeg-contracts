# Private key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URLs (optional - defaults provided)
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# BSCScan API key for contract verification
BSCSCAN_API_KEY=your_bscscan_api_key_here

# Contract addresses (for mainnet deployment)
USDC_ADDRESS=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
VENUS_USDC_ADDRESS=0xEca88125A5AdBe82614fFc12d0Db554E2E2867C8

# Multisig address (for production)
MULTISIG_ADDRESS=your_multisig_address_here

# For local testing only
FORK_URL=https://bsc-dataseed.binance.org/
FORK_BLOCK_NUMBER=latest